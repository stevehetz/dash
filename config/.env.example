# ============================================
# Dash Bot Configuration
# ============================================
# Copy this to config/.env and fill in your values

# LLM backend: "codex-p" (Codex subscription, no API tokens) or "api" (Anthropic API).
# Default is codex-p. Set to "api" to instantly revert to the API path.
DASH_LLM_BACKEND=codex-p

# Anthropic API Key — only used when DASH_LLM_BACKEND=api.
# On a CLI subscription backend this key is unset at startup so the subscription is used.
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Anthropic Admin API Key (for usage/cost reporting)
ANTHROPIC_ADMIN_KEY=

# Telegram — set to "true" to re-enable Telegram bot polling
TELEGRAM_ENABLED=true

# Telegram Bot Token
# Create a bot via @BotFather on Telegram, then paste the token here
TELEGRAM_BOT_TOKEN=

# Your Telegram user ID (so only YOU can use this bot)
# Send /start to @userinfobot on Telegram to get your ID
ALLOWED_USER_ID=

# Path to your OneDrive notes folder
# This is where the bot will read/write markdown files
ONEDRIVE_PATH=

# Optional Codex model override. Leave unset to use Codex's configured default.
# CODEX_MODEL=gpt-5.4

# OpenAI API Key (used for TTS)
OPENAI_API_KEY=

# Google Integration
GOOGLE_CREDENTIALS_PATH=./config/google-credentials.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_ACCOUNT_EMAIL=

# Resend API Key (for sending emails via dashbot.dev)
RESEND_API_KEY=

# Plaid (Banking)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
PLAID_ACCESS_TOKEN=
OPENWEATHER_API_KEY=

# Oura Ring (sleep)
OURA_PERSONAL_ACCESS_TOKEN=

# Web Push (VAPID keys for PWA notifications)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# Cloudflare (for deploying dashbot.dev via wrangler)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Shared secret for non-loopback HTTP callers (e.g. MBP voice agent); sent as X-Dash-Token
DASH_HTTP_TOKEN=
